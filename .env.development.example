APFLOW_ENV=development
DEV_SUPABASE_PROJECT_REF=ykhfrekhxdrsalwmalgt
SUPABASE_URL=https://ykhfrekhxdrsalwmalgt.supabase.co
SUPABASE_ANON_KEY=your-development-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-development-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_PASSWORD=your-development-database-password

# Local LM Studio VLM (primary)
LM_STUDIO_VLM_ENABLED=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_VLM_MODEL=
LM_STUDIO_TIMEOUT_SECONDS=120

# Gemini VLM backup
GOOGLE_API_KEY=your-google-api-key
GEMINI_VLM_MODEL=gemini-2.5-flash

# OpenRouter backup
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash

# Mailgun outbound customer invoices and delivery webhooks
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM_EMAIL=invoices@mg.example.com
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
